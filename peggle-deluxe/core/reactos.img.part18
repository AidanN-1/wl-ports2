printer		515/tcp		spooler		# BSD lpd(8)
talk		517/udp				# BSD talkd(8)
ntalk		518/udp				# SunOS talkd(8)
efs             520/tcp                         # for LucasFilm
route		520/udp		router routed	# 521/udp too
