#/usr/bin/setterm -blank 50

/bin/hostname 'dlx'
/bin/sh /etc/rc.d/rc.inet1
/bin/sh /etc/rc.d/rc.inet2

if [ -x /etc/syslogd ]; then
	syslogd  # turn on logging of su's, logins etc.
fi

if [ -x /etc/syslogk ]; then
	syslogk on > /usr/log/kernel&  # log all kernel messages.
fi

# delete this if you use a different layout
if [ -f /usr/lib/kbd/de-latin1-nodeadkeys.map ]; then
  /bin/loadkeys /usr/lib/kbd/de-latin1-nodeadkeys.map
fi

/usr/bin/gpm -t bare
