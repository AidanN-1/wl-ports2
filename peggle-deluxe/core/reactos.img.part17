#
# (C) 1996 Erich Boehm
#

if [ ! $1 ]; then
  echo
  echo "SYNTAX: `basename $0` IP-adress [netmask]"
  echo
  exit
fi

IPADDR=$1
if [ ! $2 ]; then
  NETMASK="255.255.255.0"
else
  NETMASK=$2
fi

TMP=`ipmask $NETMASK $IPADDR`
BROADCAST=`echo $TMP | cut -f1 '-d '`
NETWORK=`echo $TMP | cut -f2 '-d '`
GATEWAY=`echo $NETWORK | cut -f1-3 -d.`.$[`echo $NETWORK | cut -f4 -d.` + 1]

echo "IP        : $IPADDR"
echo "NETMASK   : $NETMASK"
echo "NETWORK   : $NETWORK"
echo "GATEWAY   : $GATEWAY"
echo "BROADCAST : $BROADCAST"

/sbin/ifconfig eth0 ${IPADDR} broadcast ${BROADCAST} netmask ${NETMASK}
/sbin/route add -net ${NETWORK} netmask ${NETMASK}
/sbin/route add default gw ${GATEWAY} eth0
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/bin/sh

# calc start of looptable
LOOPTABLE=$[(`rdev -r /dev/fd0 | cut -f2 '-d '` & 16383) - 1]

# get loopstart offset
LOOPSTART=`dd if=/dev/fd0 bs=1k skip=$LOOPTABLE count=1 | tr -cd '0-9'`

losetup /dev/loop0 /dev/fd0 -o $LOOPSTART
if [ ! -d /loop ]; then
  mkdir /loop
fi
mount /dev/loop0 /loop -t ext2
export PATH=$PATH:/loop
