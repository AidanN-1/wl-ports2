  struct _WTD_GENERIC_CHAIN_POLICY_SIGNER_INFO {
    __MINGW_EXTENSION union {
      DWORD cbStruct;
      DWORD cbSize;
    };
    PCCERT_CHAIN_CONTEXT pChainContext;
    DWORD dwSignerType;
    PCMSG_SIGNER_INFO pMsgSignerInfo;
    DWORD dwError;
