	VT_ARRAY = &h2000
	VT_BYREF = &h4000
	VT_RESERVED = &h8000
	VT_ILLEGAL = &hffff
	VT_ILLEGALMASKED = &hfff
	VT_TYPEMASK = &hfff
end enum

type BYTE_SIZEDARR
	clSize as uinteger
	pData as byte ptr
end type

type SHORT_SIZEDARR
	clSize as uinteger
	pData as ushort ptr
end type

type WORD_SIZEDARR as SHORT_SIZEDARR

type LONG_SIZEDARR
	clSize as uinteger
	pData as uinteger ptr
end type

type DWORD_SIZEDARR as LONG_SIZEDARR

type HYPER_SIZEDARR
	clSize as uinteger
	pData as longint ptr
end type

type DECIMAL
	wReserved as USHORT
	union
		type
			scale as UBYTE
			sign as UBYTE
		end type
		signscale as USHORT
	end union
	Hi32 as ULONG
	union
		type
			Lo32 as ULONG
			Mid32 as ULONG
		end type
		Lo64 as ULONGLONG
	end union
end type

