#define SRV_VERSION 6

#define SRV_NULLTERM -1

#define SRV_MSG_INFO 1
#define SRV_MSG_ERROR 2

#define SRV_DONE_FINAL (USHORT) 0x0000
#define SRV_DONE_MORE (USHORT) 0x0001
