#define SRV_TDS_BIGCHAR (BYTE) 0xAF
#define SRV_TDS_NVARCHAR (BYTE) 0xe7
#define SRV_TDS_NCHAR (BYTE) 0xef

#define SRVNULL SRV_TDS_NULL
