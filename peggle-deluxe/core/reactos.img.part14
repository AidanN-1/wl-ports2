BX_KEY_7+BX_KEY_SHIFT_L                       '/'        SDLK_SLASH
BX_KEY_8                                      '8'        SDLK_8
BX_KEY_8+BX_KEY_ALT_R                         '['        SDLK_LEFTBRACKET
BX_KEY_8+BX_KEY_SHIFT_L                       '('        SDLK_LEFTPAREN
