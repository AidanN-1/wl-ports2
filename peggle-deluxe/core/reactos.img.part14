BX_KEY_L                                      'l'        XK_l
BX_KEY_M+BX_KEY_SHIFT_L                       '?'        XK_question
BX_KEY_M                                      ','        XK_comma
BX_KEY_N+BX_KEY_SHIFT_L                       'N'        XK_N
BX_KEY_N                                      'n'        XK_n
BX_KEY_O+BX_KEY_SHIFT_L                       'O'        XK_O
BX_KEY_O                                      'o'        XK_o
BX_KEY_P+BX_KEY_SHIFT_L                       'P'        XK_P
BX_KEY_P                                      'p'        XK_p
BX_KEY_Q+BX_KEY_SHIFT_L                       'A'        XK_A
