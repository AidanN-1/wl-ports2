BX_KEY_W+BX_KEY_SHIFT_L                       'W'        SDLK_w
BX_KEY_W                                      'w'        SDLK_w
BX_KEY_X+BX_KEY_SHIFT_L                       'X'        SDLK_x
BX_KEY_X+BX_KEY_ALT_R                         '»'        SDLK_x
