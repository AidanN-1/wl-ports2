    STDMETHOD(KsSetCorrelatedPhysicalTime)(THIS_ KSCORRELATED_TIME *CorrelatedTime) PURE;
    STDMETHOD(KsGetResolution)(THIS_ KSRESOLUTION *Resolution) PURE;
