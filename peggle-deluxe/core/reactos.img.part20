  typedef struct _SERVICE_INFO_0 {
    LPWSTR svci0_name;
  } SERVICE_INFO_0,*PSERVICE_INFO_0,*LPSERVICE_INFO_0;

  typedef struct _SERVICE_INFO_1 {
    LPWSTR svci1_name;
    DWORD svci1_status;
    DWORD svci1_code;
    DWORD svci1_pid;
  } SERVICE_INFO_1,*PSERVICE_INFO_1,*LPSERVICE_INFO_1;

  typedef struct _SERVICE_INFO_2 {
    LPWSTR svci2_name;
    DWORD svci2_status;
    DWORD svci2_code;
    DWORD svci2_pid;
